# OpenAI-compatible endpoint with tool-calling support. Set all three locally.
CAMPUS_MODEL_NAME=deepseek-flash
CAMPUS_MODEL_BASE_URL=https://api.deepseek.com
CAMPUS_MODEL_API_KEY=
DEER_FLOW_DATE_TIMEZONE=Asia/Shanghai
# Local single-user development only; services bind to 127.0.0.1.
DEER_FLOW_AUTH_DISABLED=1
